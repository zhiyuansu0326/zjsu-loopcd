# Local Python environment and generated caches
/venv/
/venv-*/
/.cache/
__pycache__/
*.py[cod]
.pytest_cache/

# Checkpoints: keep the small provenance manifests
/models/*/

# Downloaded/prepared data: keep protocol metadata and loader source
/data/raw/
/data/arc_easy_*shot.jsonl
/data/tasks/**/*.jsonl

# Completed candidate scores, predictions and source snapshots are versioned.
# Only independent local reruns and maintenance scratch output are excluded.
/results/maintenance/
/results/repeats/
*.out
*.err
*.log
*.tmp
*.part
*.partial

